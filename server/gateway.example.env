# Copie para server/gateway.env, edite localmente e NUNCA publique no GitHub.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
GATEWAY_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=18777

# Google Cloud OAuth Client do tipo Desktop. Escopos readonly para Calendar e Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Todoist > Configurações > Integrações > Desenvolvedor.
TODOIST_API_TOKEN=

# Token GitHub opcional; para notificações privadas, permissão notifications read.
# Sem token, GITHUB_USERNAME permite exibir só repositórios públicos.
GITHUB_USERNAME=mateusarcedev
GITHUB_TOKEN=

# JSON LOCAL de medições observadas do Claude Code, Codex e Antigravity.
AI_USAGE_JSON=
